{
  "name": "@sky-fly/sky-components",
  "version": "0.0.3",
  "license": "MIT",
  "description": "A components library for vue",
  "keywords": [
    "vue",
    "component"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "browser": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "browser": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "homepage": "https://github.com/skyclouds2001/sky-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyclouds2001/sky-components.git"
  },
  "bugs": {
    "url": "https://github.com/skyclouds2001/sky-components/issues",
    "email": "skyclouds2001@163.com"
  },
  "author": {
    "name": "skyclouds2001",
    "email": "skyclouds2001@163.com",
    "url": "https://skyclouds2001.github.io/"
  },
  "contributors": [
    "skyclouds2001"
  ],
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=18.13.0",
    "npm": ">=9.6.0",
    "yarn": ">=1.22.0",
    "pnpm": ">=8.4.0"
  },
  "scripts": {
    "dev": "vite ./playground",
    "build": "rollup --config rollup.config.js --bundleConfigAsCjs",
    "lint": "eslint --fix . && prettier --write . && stylelint --fix && markdownlint --fix **/*.md && vue-tsc --noEmit",
    "test": "vitest",
    "clean": "rimraf node_modules && rimraf dist",
    "changeset": "changeset",
    "bump": "changeset version",
    "commit": "cz",
    "prepare": "is-ci || husky install",
    "preinstall": "only-allow pnpm"
  },
  "dependencies": {
    "element-plus": "^2.9.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.12",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-testing-library": "^7.1.1",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "markdownlint": "^0.37.4",
    "markdownlint-cli": "^0.44.0",
    "only-allow": "^1.2.1",
    "pnpm": "10.2.1",
    "postcss": "^8.5.1",
    "postcss-html": "^1.8.0",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.1.3",
    "postcss-url": "^10.1.3",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.34.6",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.84.0",
    "stylelint": "^16.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "terser": "^5.38.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
